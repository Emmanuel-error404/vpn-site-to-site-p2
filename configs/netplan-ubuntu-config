# Archivo: /etc/netplan/00-installer-config.yaml
# Equipo: Ubuntu Server (servidor web, detras de FG2)
# Proposito: IP estatica 192.168.20.2/28 con gateway en port3 de FG2
# Aplicar con: sudo netplan apply
network:
  ethernets:
    ens33:
      dhcp4: false
      dhcp6: false
      addresses:
        - 192.168.20.2/28
      routes:
        - to: default
          via: 192.168.20.1
      nameservers:
        addresses: [8.8.8.8]
      match:
        macaddress: 00:0c:29:89:df:6b
      set-name: ens33
  version: 2
